{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@orbitspatial/osls-core": ["../ts/src/index.ts"] }
  },
  "include": ["src", "../ts/src"],
  "exclude": ["../ts/src/**/__tests__"]
}
